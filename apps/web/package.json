{
  "name": "@roam/web",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "serve dist -s -l tcp://0.0.0.0:${PORT:-8080} --no-clipboard",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "node --stack-size=8000 ../../node_modules/typescript/lib/tsc.js --noEmit",
    "build": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "expo": "~57.0.19",
    "expo-image-manipulator": "~57.0.15",
    "expo-image-picker": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "leaflet": "^1.9.4",
    "lucide-react-native": "^1.40.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
